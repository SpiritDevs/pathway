# Required: deployment providers (consumed by Alchemy, not bound into the Worker)
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
AXIOM_ORG_ID=...
AXIOM_TOKEN=...

# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=spiritdevs.com
RELAY_TUNNEL_ZONE_NAME=spiritdevs.com

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.spiritdevs.com

# Required: Convex deployment used for relay durable state
# Use the deployment client URL written by `convex dev`, not the HTTP actions
# URL or a deploy key. Relay authentication uses an Alchemy-managed P-256 key.
CONVEX_URL=https://example-deployment.convex.cloud

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `pathway-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=pathway-relay

# Optional: Apple Push Notification service
# Leave disabled when mobile push notifications and Live Activities are not
# needed. When enabled, all five credential values below are required.
APNS_ENABLED=false
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=...
# APNS_KEY_ID=...
# APNS_BUNDLE_ID=...
# APNS_PRIVATE_KEY=...
