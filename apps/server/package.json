    "@spiritdevs/shared": "workspace:*",
    "@spiritdevs/tailscale": "workspace:*",
    "@spiritdevs/web": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/mailparser": "^3.4.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/smtp-server": "^3.5.13",
    "convex": "^1.16.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "nodemailer": "^9.0.5",
    "vite-plus": "catalog:"
