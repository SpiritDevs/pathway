<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connect to your Pathway environments on your local network.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>PATHWAY_APS_ENVIRONMENT</key>
    <string>$(APS_ENVIRONMENT)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Pathway Clerk callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pathway</string>
			</array>
		</dict>
	</array>
	<key>PATHWAY_CLERK_PUBLISHABLE_KEY</key>
	<string>$(PATHWAY_CLERK_PUBLISHABLE_KEY)</string>
	<key>PATHWAY_CLERK_JWT_TEMPLATE</key>
	<string>$(PATHWAY_CLERK_JWT_TEMPLATE)</string>
	<key>PATHWAY_CONVEX_URL</key>
	<string>$(PATHWAY_CONVEX_URL)</string>
	<key>PATHWAY_RELAY_URL</key>
	<string>$(PATHWAY_RELAY_URL)</string>
	<key>PATHWAY_SITE_URL</key>
	<string>$(PATHWAY_SITE_URL)</string>
</dict>
</plist>
