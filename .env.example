# Optional: Pathway Connect source builds
# Copy this file to `.env`, then fill in the Pathway Clerk public identifiers
# below to enable Pathway Connect. These values are not secrets.
# Do not add server-side secrets to this file.

# Pathway Clerk instance. Get these from the Clerk Dashboard under API keys,
# JWT templates, and OAuth applications. The OAuth application must be public
# and allow https://app.pathwayos.dev/connect/callback.
# PATHWAY_CLERK_PUBLISHABLE_KEY=pk_live_...
# PATHWAY_CLERK_JWT_TEMPLATE=pathway-relay
# PATHWAY_CLERK_CLI_OAUTH_CLIENT_ID=...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in PATHWAY_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# PATHWAY_APPLE_TEAM_ID=ABC1234567
# PATHWAY_MACOS_PROVISIONING_PROFILE=/absolute/path/to/pathway.provisionprofile
# Signed cua flavor builds (com.spiritdevs.pathway.cua) need their own profile; there is no fallback.
# PATHWAY_MACOS_CUA_PROVISIONING_PROFILE=/absolute/path/to/pathway-cua.provisionprofile
# PATHWAY_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
PATHWAY_RELAY_URL=https://relay.spiritdevs.com

# Desktop artifact builds deploy `packages/backend` to PATHWAY_CYNDRBASE_URL before
# packaging, so an app never ships against a backend from an older commit. That
# needs the deployment's id, deploy API URL and deploy key. The key is a secret:
# keep it in the gitignored `.env.prod` you build with, not here. Pass
# --skip-backend-deploy to package without deploying. Leave PATHWAY_CYNDRBASE_URL
# unset in development: `vp run dev` starts a local Cyndrbase for this worktree.
# PATHWAY_CYNDRBASE_URL=https://<deployment>.<region>.cyndrbase.cloud
# CYNDRBASE_URL=https://<deploy-api-host>
# CYNDRBASE_DEPLOYMENT=<deployment>
# CYNDRBASE_DEPLOY_KEY=...

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.pathwayos.dev; override for another hosted deployment.
# PATHWAY_HOSTED_APP_URL=https://app.pathwayos.dev

# Optional: public Mapbox Search Box token for event location autocomplete.
# Restrict this token to the Search Box API and the origins that serve Pathway.
# VITE_MAPBOX_SEARCH_TOKEN=pk...

# Public, ingest-only mobile OpenTelemetry configuration.
