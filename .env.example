# Optional: Pathway Connect source builds
# Copy this file to `.env`, then fill in the Pathway Clerk public identifiers
# below to enable Pathway Connect. These values are not secrets.
# Do not add server-side secrets to this file.

# Pathway Clerk instance. Get these from the Clerk Dashboard under API keys,
# JWT templates, and OAuth applications. The OAuth application must be public
# and allow https://app.spiritdevs.com/connect/callback.
# PATHWAY_CLERK_PUBLISHABLE_KEY=pk_live_...
# PATHWAY_CLERK_JWT_TEMPLATE=pathway-relay
# PATHWAY_CLERK_CLI_OAUTH_CLIENT_ID=...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in PATHWAY_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# PATHWAY_APPLE_TEAM_ID=ABC1234567
# PATHWAY_MACOS_PROVISIONING_PROFILE=/absolute/path/to/pathway.provisionprofile
# PATHWAY_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
PATHWAY_RELAY_URL=https://relay.spiritdevs.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.spiritdevs.com; override to test against a staging deployment.
# PATHWAY_HOSTED_APP_URL=https://nightly.app.spiritdevs.com

# Public, ingest-only mobile OpenTelemetry configuration.
# PATHWAY_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# PATHWAY_MOBILE_OTLP_TRACES_DATASET=pathway-mobile-traces-dev
# PATHWAY_MOBILE_OTLP_TRACES_TOKEN=xaat-...
